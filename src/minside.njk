---
layout: "base.njk"
loggedIn: true
pagination:
  data: users
  size: 1
  alias: user
permalink: "/{{ user.name | slugify }}/minside/index.html"
---

<div class="container container--prose">
  <header class="page-header">
    <div class="page-crumbs"><span>Min side</span> /</div>
    <h1>Hei, {{ user.name or users[0].name }}</h1>
  </header>

  <div class="page-section card card--product">
    <div class="stack-text">
      <a href="/{{ user.name | slugify }}/minside/oppgaver/">
        <strong>Varsler</strong>
      </a>
      <small>1 oppgave, 1 beskjed</small>
    </div>
  </div>

  {% if user.products %}
  <section class="page-section">
    <h2 class="page-section__title">Pengestøtte</h2>
    <div class="page-section__content" style="display:grid; gap:var(--ax-space-6)">
      {%- for item in user.products %}
        {%- if item.access %}
          <article class="card card--product stack-text" {{- 'data-status=new' if loop.first -}}>
            <a class="card__title" href="/{{ user.name | slugify }}/minside/{{ item.url }}/">{{ item.title }}</a>
            {% if item.status %}<small>{{ item.status }}</small>{% endif %}
          </article>
        {%- else %}
          <article class="card invisible">
            <a href="/{{ user.name | slugify }}/minside/{{ item.url }}/">{{ item.title }}</a>
          </article>
        {%- endif %}
      {%- endfor %}
    </div>
  </section>
  {% endif %}

  {% if user.support %}
  <section class="page-section">
    <h2 class="page-section__title">Oppfølging fra Nav</h2>
    <div class="page-section__content" style="display:grid; gap:var(--ax-space-6)">
      {%- for item in user.support %}
        {%- if item.access %}
          <article class="card card--product stack-text" {{- 'data-status=new' if loop.first -}}>
            <a class="card__title" href="/{{ user.name | slugify }}/minside/{{ item.url }}/">{{ item.title }}</a>
            {% if item.status %}<small>{{ item.status }}</small>{% endif %}
          </article>
        {%- else %}
          <article class="card invisible">
            <a href="/{{ user.name | slugify }}/minside/{{ product.url }}/">{{ product.title }}</a>
          </article>
        {%- endif %}
        {% if user.type === 'agent' %}
          <article class="card invisible">
            <a href="/{{ user.name | slugify }}/minside/foreldrepenger/">Foreldrepenger</a>
          </article>
        {% endif %}
      {%- endfor %}
    </div>
  </section>
  {% endif %}

  <section class="page-section">
    <h2 class="page-section__title">Fellestjenester</h2>
    <div class="page-section__content" style="display: grid;grid-template-columns:1fr 1fr;gap:var(--ax-space-8)">
      <div class="card card--product">
        <a href="#">Innboks</a>
      </div>
      <div class="card card--product">
        <a href="#">Dokumenter</a>
      </div>
    </div>
  </section>

</div>
